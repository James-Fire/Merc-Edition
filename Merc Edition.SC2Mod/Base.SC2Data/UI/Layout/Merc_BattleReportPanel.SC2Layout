<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
    <!--
        Restores the WoL battle report panel by hiding the LotV added frames
        re-anchoring elements and restoring colors to WoL values.
    -->
    <!-- Constants -->
    <Constant name="BattleReportListBoxItemNormalBackgroundMission" val="7fd5ec"/>
    <Constant name="BattleReportListBoxItemNormalBackgroundCinematic" val="d49736"/>
    <Constant name="BattleReportListBoxItemHoverBackgroundMission" val="92def0"/>
    <Constant name="BattleReportListBoxItemHoverBackgroundCinematic" val="d49736"/>
    <Constant name="BattleReportListBoxItemNormalTextMission" val="92def0"/>
    <Constant name="BattleReportListBoxItemNormalTextCinematic" val="ffc616"/>
    <Constant name="BattleReportNormalDifficultyAvailable" val="00ff09"/>
    <Constant name="BattleReportHoverDifficultyCompleted" val="7fd7eb"/>
    <Constant name="BattleReportHoverDifficultyAvailable" val="00fd00"/>

    <!-- Restored Battle Report Panel -->

    <Frame type="BattleReportListBoxItem" name="BattleReportListBoxItem" file="BattleReportPanel">
        <Frame type="Image" name="NormalBackgroundImage">
            <Texture val="@@UI/BattleReportListBoxBackgroundNormal" layer="0"/>
            <TextureType val="Border" layer="0"/>
            <StateCount val="2" layer="0"/>
            <BlendMode val="Add"/>
        </Frame>
        <Frame type="Image" name="HoverBackgroundImage">
            <Texture val="@@UI/BattleReportListBoxBackgroundHover" layer="0"/>
            <TextureType val="Border" layer="0"/>
            <StateCount val="2" layer="0"/>
            <BlendMode val="Add"/>
        </Frame>
        <Frame type="Image" name="NormalButtonBackgroundImage">
            <Anchor side="Bottom" relative="$parent/NormalBackgroundImage" pos="Max" offset="-12"/>
        </Frame>
        <Frame type="Image" name="HoverButtonBackgroundImage">
            <Anchor side="Bottom" relative="$parent/NormalBackgroundImage" pos="Max" offset="-12"/>
        </Frame>
        <Frame type="Image" name="ButtonImage">
            <Anchor side="Top" relative="$parent/NormalBackgroundImage" pos="Min" offset="9"/>
        </Frame>
        <Frame type="Label" name="TextLabel">
            <Anchor side="Top" relative="$parent/NormalBackgroundImage" pos="Min" offset="15"/>
            <Anchor side="Left" relative="$parent/NormalBackgroundImage" pos="Min" offset="70"/>
            <Anchor side="Right" relative="$parent/NormalBackgroundImage" pos="Max" offset="-10"/>
            <Style val="BattleReportPanelListBoxText"/>
            <Alpha val="190"/>
            <Anchor side="Bottom" relative="$parent/NormalBackgroundImage" pos="Min" offset="37"/>
        </Frame>
        <Frame type="Label" name="TypeLabel">
            <Visible val="true"/>
        </Frame>
        <Frame type="Image" name="SelectedBackgroundImage">
            <Visible val="false"/>
        </Frame>
    </Frame>
    <Frame type="BattleReportPanel" name="BattleReportPanelTemplate" file="BattleReportPanel">
