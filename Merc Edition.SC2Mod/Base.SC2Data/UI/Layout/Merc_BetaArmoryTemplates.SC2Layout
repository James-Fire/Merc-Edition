                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Left" relative="False">
                    <Key type="Curve" time="0" value="-104" in="linear" out="linear"/>
                    <Key type="Curve" time="0.233" value="-104" in="linear" out="linear"/>
                    <Key type="Curve" time="0.467" value="0" in="linear" out="linear"/>
