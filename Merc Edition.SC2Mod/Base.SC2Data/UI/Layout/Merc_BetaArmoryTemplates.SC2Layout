        <Frame type="Image" name="PurchaseBandV">
            <Anchor side="Left" relative="$parent" pos="Min" offset="-53"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="-54"/>
            <Width val="150"/>
            <Height val="48"/>
            <Rotation val="270"/>
            <Texture val="Assets\Textures\techpurchase_scanlines.dds"/>
            <Unclipped val="True"/>
