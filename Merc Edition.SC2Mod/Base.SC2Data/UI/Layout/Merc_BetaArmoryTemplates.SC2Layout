    <Frame type="Frame" name="ArmoryCategoryButtonModuleTemplate">
        <Anchor side="Top" relative="$sibling-1" pos="Max" offset="1"/>
        <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>

        <Height val="72"/>

        <Frame type="Frame" name="ArmyUnitIcon" template="Merc_BetaArmoryTemplates/ArmyCategoryUnitIconTemplate">
        </Frame>

        <Frame type="Button" name="ArmyUpgrade1" template="Merc_BetaArmoryTemplates/ArmyTechButtonTemplate">
            <Anchor side="Left" relative="$parent/ArmyUnitIcon" pos="Max" offset="4"/>
        </Frame>

        <Frame type="Button" name="ArmyUpgrade2" template="Merc_BetaArmoryTemplates/ArmyTechButtonTemplate">
        </Frame>

        <StateGroup name="DataState">
            <DefaultState val="Normal"/>

            <State name="Normal">
                <When type="AnimationState" frame="$this" DataState="Normal"/>

                <Action type="SetProperty" frame="$this/ArmyUnitIcon/Icon" Visible="True"/>
            </State>

            <State name="Unaffordable">
                <When type="AnimationState" frame="$this" DataState="Unaffordable"/>

                <Action type="SetProperty" frame="$this/ArmyUnitIcon/Icon" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/ArmyUnitIcon/Icon" AdjustmentColor="8a0000"/>
            </State>

            <State name="Empty">
                <When type="AnimationState" frame="$this" DataState="Empty"/>

                <Action type="SetProperty" frame="$this/ArmyUnitIcon/Icon" Visible="False"/>
                <Action type="SetProperty" frame="$this/ArmyUpgrade1" Visible="False"/>
                <Action type="SetProperty" frame="$this/ArmyUpgrade2" Visible="False"/>
            </State>

            <State name="Locked">
                <When type="AnimationState" frame="$this" DataState="Locked"/>

                <Action type="SetProperty" frame="$this/ArmyUnitIcon/Icon" Visible="False"/>
                <Action type="SetProperty" frame="$this/ArmyUpgrade1" Visible="False"/>
                <Action type="SetProperty" frame="$this/ArmyUpgrade2" Visible="False"/>
            </State>
        </StateGroup>
    </Frame>

    <Frame type="Frame" name="TechArmyCategoryPanelTemplate">
        <Frame type="Image" name="TitleHeader" template="Merc_BetaArmoryTemplates/TechCategoryTitleHeaderTemplate">
            <Anchor side="Left" relative="$parent" pos="Min" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="0"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        </Frame>

        <Frame type="Label" name="TitleLabel">
            <Anchor relative="$parent/TitleHeader"/>

            <Style val="BetaArmory_GroupName"/>
            <Text val="Base"/>
        </Frame>

        <Frame type="Frame" name="ArmoryCategoryModule1" template="Merc_BetaArmoryTemplates/ArmoryCategoryButtonModuleTemplate">
            <Anchor side="Top" relative="$parent/TitleHeader" pos="Max" offset="-1"/>
        </Frame>

        <Frame type="Frame" name="ArmoryCategoryModule2" template="Merc_BetaArmoryTemplates/ArmoryCategoryButtonModuleTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="2"/>
        </Frame>
        <Frame type="Frame" name="ArmoryCategoryModule3" template="Merc_BetaArmoryTemplates/ArmoryCategoryButtonModuleTemplate">
            <Anchor side="Top" relative="$sibling-1" pos="Max" offset="-2"/>
        </Frame>    
        
        <Frame type="Frame" name="ArmoryCategoryModule4" template="Merc_BetaArmoryTemplates/ArmoryCategoryButtonModuleTemplate"/>
        <Frame type="Frame" name="ArmoryCategoryModule5" template="Merc_BetaArmoryTemplates/ArmoryCategoryButtonModuleTemplate"/>
    </Frame>
</Desc>
