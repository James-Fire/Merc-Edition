<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>

    <Frame type="Image" name="TechCategoryTitleHeaderTemplate">

        <Texture val="Assets\Textures\ui_load_frame_columtitle_normaloverpressedover.dds"/>
        <TextureType val="EndCap"/>
        <StateCount val="2"/>
        <Height val="40"/>
    </Frame>

    <Frame type="Button" name="TechPurchaseButtonTemplate">
        <Width val="390"/>
        <Height val="65"/>

        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <HitTestFrame val="HitTestFrame"/>
        <Text val="@UI/PurchasePanelPurchase"/>
        <Style val="BetaArmory_PurchaseButton"/>

        <Frame type="Frame" name="HitTestFrame">
            <Anchor side="Left" relative="$parent" pos="Min" offset="5"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="-5"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="-5"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="5"/>
        </Frame>

        <Frame type="Image" name="NormalImage">
            <Anchor relative="$parent"/>

            <StateCount val="2"/>
            <Texture val="Assets\Textures\ui_battlenet_glue_mediumorangebutton_normalpressed.dds"/>
            <TextureType val="EndCap"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor relative="$parent"/>

            <StateCount val="2"/>
            <Texture val="Assets\Textures\ui_battlenet_glue_mediumorangebutton_normaloverpressedover.dds"/>
            <TextureType val="EndCap"/>
        </Frame>

        <Frame type="Image" name="PurchaseFlash">
            <Anchor relative="$parent"/>
            <StateCount val="2"/>
            <Texture val="Assets\Textures\ui_battlenet_glue_mediumorangebutton_normaloverpressedover.dds"/>
            <TextureType val="EndCap"/>
            <BlendMode val="Add"/>
            <Visible val="False"/>

            <Animation name="PurchaseFX">
                <Event event="PurchaseFX" action="Reset,Play" frame="$parent"/>

                <Controller type="Sound" end="Pause" frame="$this">
                    <Key type="Sound" time="0.0" sound="@TUI_ArmoryConsolePurchase"/>
                </Controller>

                <Controller type="Visibility" end="Pause" frame="$this">
                    <Key type="Bool" time="0.0" value="True"/>
                    <Key type="Bool" time="0.6" value="False"/>
                </Controller>

                <Controller type="Fade" end="Pause" frame="$this">
                    <Key type="Curve" time="0.0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.08" value="200" in="linear" out="linear"/>
                    <Key type="Curve" time="0.6" value="0" in="linear" out="linear"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Image" name="PurchaseShimmer">
            <Anchor relative="$parent"/>
            <Visible val="False"/>
            <LayerCount val="2"/>


            <Texture val="Assets\Textures\ui_battlenet_glue_mediumorangebutton_normalpressed.dds" layer="0"/>
            <TextureType val="EndCap" layer="0"/>
            <StateCount val="2" layer="0"/>
            <AlphaLayer val="True" layer="0"/>

            <Texture val="Assets\Textures\sc2_ui_ingame_storymode_highlightshimmer.dds" layer="1"/>
            <TextureType val="Normal" layer="1"/>
            <Height val="120" layer="1"/>
            <BlendMode val="Add" layer="1"/>

            <Animation name="PurchaseFX">
                <Event event="PurchaseFX" action="Reset,Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause" frame="$this">
                    <Key type="Bool" time="0.05" value="True"/>
                    <Key type="Bool" time="0.75" value="False"/>
                </Controller>

                <Controller type="LayerUV" layer="1" side="Top" relative="False" sidelock="True" end="Pause">
                    <Key type="Curve" time="0" value="-2" out="Fast"/>
                    <Key type="Curve" time="0.05" value="-2" out="Fast"/>
                    <Key type="Curve" time="0.75" value="1.1" in="Slow"/>
                </Controller>
            </Animation>
        </Frame>
    </Frame>

    <!-- Composite Panels -->

    <!-- Tech Army Category Panel Templates -->
    <Frame type="Frame" name="ArmyCategoryUnitIconTemplate">
        <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Left" relative="$parent" pos="Min" offset="8"/>

        <Width val="60"/>
        <Height val="60"/>

        <Frame type="Image" name="ArmyUnitBackground">
            <Anchor relative="$parent"/>

            <Texture val="Assets\Textures\btn-ability-zerg-genemutation-carapace.dds"/>
            <ColorAdjustMode val="Fill"/>
            <AdjustmentColor val="000000"/>
        </Frame>

        <Frame type="Image" name="Icon">
            <Anchor relative="$parent" offset="-4"/>

            <Texture val="Assets\Textures\btn-unit-terran-scv.dds"/>
            <Visible val="True"/>
        </Frame>
    </Frame>

    <Frame type="Button" name="ArmyTechButtonTemplate">
        <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Left" relative="$sibling-1" pos="Max" offset="7"/>

        <Width val="52"/>
        <Height val="52"/>
        <Toggleable val="True"/>
        <Visible val="True"/>

        <StateGroup name="UpgradeState">
            <DefaultState val="Unaffordable"/>

            <State name="Available">
                <When type="AnimationState" frame="$this" UpgradeState="Available"/>

                <Action type="SetProperty" frame="$this/UpgradeIcon" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/UpgradeIcon" LightAdjustColor="93ff8f"/>
            </State>

            <State name="Unaffordable">
                <When type="AnimationState" frame="$this" UpgradeState="Unaffordable"/>

                <Action type="SetProperty" frame="$this/NormalImage" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/NormalImage" AdjustmentColor="8a0000"/>
                <Action type="SetProperty" frame="$this/HoverImage" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/HoverImage" AdjustmentColor="8a0000"/>
                <Action type="SetProperty" frame="$this/UpgradeIcon" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/UpgradeIcon" LightAdjustColor="c40000"/>
            </State>

            <State name="Purchased">
                <When type="AnimationState" frame="$this" UpgradeState="Purchased"/>

                <Action type="SetProperty" frame="$this/PurchasedGlow" Visible="True"/>

                <Action type="SetProperty" frame="$this/NormalImage" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/NormalImage" AdjustmentColor="006a8a"/>
                <Action type="SetProperty" frame="$this/HoverImage" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/HoverImage" AdjustmentColor="006a8a"/>
                <Action type="SetProperty" frame="$this/UpgradeIcon" ColorAdjustMode="Colorize"/>
                <Action type="SetProperty" frame="$this/UpgradeIcon" LightAdjustColor="3192af"/>
            </State>
        </StateGroup>

        <StateGroup name="Toggled">
            <State name="Normal">
                <When type="Property" frame="$this" Toggled="False"/>
            </State>

            <State name="Toggled">
                <When type="Property" frame="$this" Toggled="True"/>

                <Action type="SetProperty" frame="$this/NormalImage" Texture="Assets\Textures\ui_console_commandbutton_highlighted_defaultterran.dds"/>
                <Action type="SetProperty" frame="$this" RenderPriority="600"/>
                <Action type="SetProperty" frame="$parent" RenderPriority="600"/>
                <Action type="SetProperty" frame="$parent/$parent" RenderPriority="600"/>
            </State>
        </StateGroup>

        <Frame type="Image" name="PurchasedGlow">
            <Anchor side="Left" relative="$parent" pos="Min" offset="-22"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="22"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="-21"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="23"/>
            
            <Texture val="Assets\Textures\ui_techpurchase_button_terran_purchased.dds"/>
            <Unclipped val="True"/>
            <Visible val="False"/>
        </Frame>

        <Frame type="Image" name="NormalImage">
            <Anchor relative="$parent"/>

            <Texture val="Assets\Textures\ui_console_commandbutton_normal_defaultterran.dds"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor relative="$parent"/>

            <Texture val="Assets\Textures\ui_console_commandbutton_highlighted_defaultterran.dds"/>
        </Frame>

        <Frame type="Image" name="UpgradeIcon">
            <Anchor relative="$parent" offset="-1"/>

            <Texture val="Assets\Textures\btn-techupgrade-terran-attacksair.dds"/>

            <Frame type="Image" name="HoverAdd">
                <Anchor relative="$parent"/>

                <Texture val="{$parent/@Texture}"/>
                <BlendMode val="Add"/>
                <Visible val="{$parent/$parent/@Hovering}"/>
                <Alpha val="50"/>

                <StateGroup name="HoverAdd">
                    <DefaultState val="Normal"/>

                    <State name="Normal">
                        <When type="Property" frame="$parent/$parent" Hovering="False"/>
                        <When type="Property" frame="$parent/$parent" Toggled="False"/>
                        <Action type="SetProperty" frame="$this" Visible="False"/>
                    </State>

                    <State name="Hover">
                        <When type="Property" frame="$parent/$parent" Hovering="True"/>

                        <Action type="SetProperty" frame="$this" Visible="True"/>
                    </State>

                    <State name="Toggled">
                        <When type="Property" frame="$parent/$parent" Toggled="True"/>

                        <Action type="SetProperty" frame="$this" Visible="True"/>
                    </State>
                </StateGroup>
            </Frame>
        </Frame>

        <Frame type="Image" name="PurchaseFrame">
            <Anchor side="Left" relative="$parent" pos="Min" offset="-20"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="-20"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
            <Texture val="Assets\Textures\techpurchase_frame.dds"/>
            <Unclipped val="True"/>
            <Visible val="False"/>

            <Animation name="PurchaseFX">
                <Event event="PurchaseFX" action="Reset,Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause" frame="$this">
                    <Key type="Bool" time="0.0" value="True"/>
                    <Key type="Bool" time="0.067" value="False"/>
                    <Key type="Bool" time="0.1" value="True"/>
                    <Key type="Bool" time="0.167" value="False"/>
                    <Key type="Bool" time="0.233" value="True"/>
                    <Key type="Bool" time="0.3" value="False"/>
                    <Key type="Bool" time="0.367" value="True"/>
                    <Key type="Bool" time="1.75" value="False"/>
                </Controller>

                <Controller type="Fade" end="Pause" frame="$this">
                    <Key type="Curve" time="0.0" value="107" in="linear" out="linear"/>
                    <Key type="Curve" time="0.067" value="107" in="linear" out="linear"/>
                    <Key type="Curve" time="0.1" value="255" in="linear" out="linear"/>
                    <Key type="Curve" time="0.833" value="255" in="linear" out="linear"/>
                    <Key type="Curve" time="1.267" value="204" in="linear" out="linear"/>
                    <Key type="Curve" time="1.4" value="204" in="linear" out="linear"/>
                    <Key type="Curve" time="1.75" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Left" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="-6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Top" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="-6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Right" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Bottom" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Image" name="PurchaseFrameFlash">
            <Anchor side="Left" relative="$parent" pos="Min" offset="-20"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="-20"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
            <Texture val="Assets\Textures\techpurchase_frame.dds"/>
            <Color val="65BBA7"/>
            <BlendMode val="Add"/>
            <Unclipped val="True"/>
            <Visible val="False"/>

            <Animation name="PurchaseFX">
                <Event event="PurchaseFX" action="Reset,Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause" frame="$this">
                    <Key type="Bool" time="0.367" value="True"/>
                    <Key type="Bool" time="0.833" value="False"/>
                </Controller>

                <Controller type="Fade" end="Pause" frame="$this">
                    <Key type="Curve" time="0" value="217" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="217" in="linear" out="linear"/>
                    <Key type="Curve" time="0.833" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Left" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="-6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Top" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="-6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Right" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>

                <Controller type="Anchor" end="Pause" frame="$this" side="Bottom" relative="True">
                    <Key type="Curve" time="0" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.333" value="0" in="linear" out="linear"/>
                    <Key type="Curve" time="0.367" value="6" in="linear" out="linear"/>
                    <Key type="Curve" time="0.8" value="0" in="linear" out="linear"/>
                </Controller>
            </Animation>
        </Frame>

        <Frame type="Image" name="PurchaseFrameEcho">
            <Anchor side="Left" relative="$parent" pos="Min" offset="-20"/>
            <Anchor side="Right" relative="$parent" pos="Max" offset="20"/>
            <Anchor side="Top" relative="$parent" pos="Min" offset="-20"/>
            <Anchor side="Bottom" relative="$parent" pos="Max" offset="20"/>
            <Texture val="Assets\Textures\techpurchase_frame.dds"/>
            <Unclipped val="True"/>
            <Visible val="False"/>

            <Animation name="PurchaseFX">
                <Event event="PurchaseFX" action="Reset,Play" frame="$parent"/>

                <Controller type="Visibility" end="Pause" frame="$this">
                    <Key type="Bool" time="0.367" value="True"/>
                    <Key type="Bool" time="0.867" value="False"/>
                </Controller>
            </Animation>
        </Frame>

