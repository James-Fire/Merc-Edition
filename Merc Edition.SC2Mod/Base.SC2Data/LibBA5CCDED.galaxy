bool libBA5CCDED_gt_Iseedeadpeople_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((TriggerIsEnabled(libBA5CCDED_gt_SpawnInfested) == false)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Units spawn infested on death"));
