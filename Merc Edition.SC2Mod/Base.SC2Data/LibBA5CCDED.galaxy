text libBA5CCDED_gf_MU_FormatCredits (int lp_value) {
    // Variable Declarations
    int lv_amount;
    string lv_digits;
    string lv_grouped;
    string lv_sign;
    int lv_length;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_digits = "";
    lv_grouped = "";
    lv_sign = "";

    // Implementation
    lv_amount = lp_value;
    if ((lv_amount < 0)) {
        lv_sign = "-";
        lv_amount = (0 - lv_amount);
    }

    lv_digits = IntToString(lv_amount);
    lv_length = StringLength(lv_digits);
    while ((lv_length > 3)) {
        lv_grouped = ("," + StringSub(lv_digits, (lv_length - 2), lv_length) + lv_grouped);
        lv_digits = StringSub(lv_digits, 1, (lv_length - 3));
        lv_length = (lv_length - 3);
    }
    return StringToText((lv_sign + "$" + lv_digits + lv_grouped));
}

