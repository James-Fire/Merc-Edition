//--------------------------------------------------------------------------------------------------
// Trigger: Nightmare Plus Initial
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_NightmarePlusInitial_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto8CFDA2F3_g;
    int auto8CFDA2F3_u;
    unit auto8CFDA2F3_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto8CFDA2F3_g = UnitGroup(null, 1, RegionEntireMap(), UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32))), 0);
    auto8CFDA2F3_u = UnitGroupCount(auto8CFDA2F3_g, c_unitCountAll);
    for (;; auto8CFDA2F3_u -= 1) {
        auto8CFDA2F3_var = UnitGroupUnitFromEnd(auto8CFDA2F3_g, auto8CFDA2F3_u);
        if (auto8CFDA2F3_var == null) { break; }
        UnitBehaviorAddPlayer(auto8CFDA2F3_var, "NightmarePlus", 1, 1);
    }
    return true;
}

