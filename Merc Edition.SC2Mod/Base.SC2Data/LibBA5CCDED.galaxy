//--------------------------------------------------------------------------------------------------
// Trigger: MU_PurchaseButtonPressed
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_MU_PurchaseButtonPressed_Func (bool testConds, bool runActions) {
    // Variable Declarations
    string lv_upgrade;
    int lv_cost;
    int lv_oldCredits;
    int lv_step;

    // Automatic Variable Declarations
    const int auto47DA0B83_ae = 30;
    const int auto47DA0B83_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == libBA5CCDED_gv_mU_Armory.lv_techPurchaseButton))) {
            return false;
        }

        if (!((EventPlayer() == 1))) {
            return false;
        }

        if (!((libBA5CCDED_gv_mU_PurchaseInProgress == false))) {
            return false;
        }

        if (!((libBA5CCDED_gv_mU_Armory.lv_selectedUpgrade != null))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libBA5CCDED_gt_PurchaseButtonSFX, true, false);
    lv_upgrade = libBA5CCDED_gv_mU_Armory.lv_selectedUpgrade;
    lv_cost = libBA5CCDED_gf_MU_UpgradeCost(lv_upgrade);
    lv_oldCredits = libCamp_gf_StoryCredits();
    if ((libCamp_gf_MercTryPurchaseTech(libBA5CCDED_gf_MU_UpgradeTech(lv_upgrade)) == false)) {
        libBA5CCDED_gf_MU_UpdateArmoryPanel();
        libBA5CCDED_gf_MU_SetInfoPanel(lv_upgrade);
        return true;
    }

    libBA5CCDED_gv_mU_PurchaseInProgress = true;
    DialogControlSetVisible(libBA5CCDED_gv_mU_Armory.lv_inputBlocker, PlayerGroupAll(), true);
    DialogControlSendAnimationEvent(libBA5CCDED_gv_mU_Armory.lv_techPurchaseButton, PlayerGroupAll(), "PurchaseFX");
    DialogControlSendAnimationEvent(libBA5CCDED_gv_mU_Armory.lv_armyCategory_UpgradeButton[libBA5CCDED_gv_mU_Armory.lv_selected_Category][libBA5CCDED_gv_mU_Armory.lv_selected_Unit][libBA5CCDED_gv_mU_Armory.lv_selected_Upgrade], PlayerGroupAll(), "PurchaseFX");
    lv_step = 1;
    for ( ; ( (auto47DA0B83_ai >= 0 && lv_step <= auto47DA0B83_ae) || (auto47DA0B83_ai < 0 && lv_step >= auto47DA0B83_ae) ) ; lv_step += auto47DA0B83_ai ) {
        libNtve_gf_SetDialogItemText(libBA5CCDED_gv_mU_Armory.lv_creditsLabel, libBA5CCDED_gf_MU_FormatCredits((lv_oldCredits - ((((lv_cost * lv_step) / 30) / 1000) * 1000))), PlayerGroupAll());
        Wait(0.0333, c_timeReal);
    }
    libBA5CCDED_gf_MU_UpdateArmoryPanel();
    libBA5CCDED_gf_MU_SetInfoPanel(lv_upgrade);
    DialogControlSetVisible(libBA5CCDED_gv_mU_Armory.lv_inputBlocker, PlayerGroupAll(), false);
    libBA5CCDED_gv_mU_PurchaseInProgress = false;
    return true;
}

