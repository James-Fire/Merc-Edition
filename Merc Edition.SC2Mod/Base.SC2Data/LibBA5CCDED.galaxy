//--------------------------------------------------------------------------------------------------
// Trigger: Cabal Cybernetic Reconstruction (Assault)
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_CabalCyberneticReconstructionAssault_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_unit;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_unit = UnitGroupClosestToPoint(UnitGroup("HelsAngelAssault", EventPlayer(), RegionCircle(EventPlayerEffectUsedPoint(c_effectLocationCasterUnit), 20.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), EventPlayerEffectUsedPoint(c_effectLocationCasterUnit));
    if ((lv_unit == null)) {
        lv_unit = UnitGroupClosestToPoint(UnitGroup("HelsAngelFighter", EventPlayer(), RegionCircle(EventPlayerEffectUsedPoint(c_effectLocationCasterUnit), 20.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), EventPlayerEffectUsedPoint(c_effectLocationCasterUnit));
    }

    if ((lv_unit == null)) {
        lv_unit = UnitGroupClosestToPoint(UnitGroup("HelsAngelAssault", EventPlayer(), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), EventPlayerEffectUsedPoint(c_effectLocationCasterUnit));
    }

    if ((lv_unit == null)) {
        lv_unit = UnitGroupClosestToPoint(UnitGroup("HelsAngelFighter", EventPlayer(), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), EventPlayerEffectUsedPoint(c_effectLocationCasterUnit));
    }

    if ((lv_unit == null)) {
        return true;
    }

    UnitIssueOrder(lv_unit, Order(AbilityCommand("CabalAssaultTakeoverMorph", 0)), c_orderQueueReplace);
    UnitIssueOrder(lv_unit, Order(AbilityCommand("CabalFighterTakeoverMorph", 0)), c_orderQueueReplace);
    UnitCreateEffectUnit(lv_unit, "CabalAssaultReviveDummy", lv_unit);
    UnitBehaviorAdd(lv_unit, "CabalRevive1", lv_unit, 1);
    return true;
}

