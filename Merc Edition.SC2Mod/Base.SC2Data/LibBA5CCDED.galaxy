//--------------------------------------------------------------------------------------------------
// Trigger: Open Banks
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_OpenBanks_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("VanillaPlusWOL", 1);
    libBA5CCDED_gv_eventBank = BankLastCreated();
    libBA5CCDED_gv_zeusCount = BankValueGetAsInt(libBA5CCDED_gv_eventBank, "Persistent Units", "ZeusCount");
    libBA5CCDED_gv_odinRescued = BankValueGetAsFlag(libBA5CCDED_gv_eventBank, "Persistent Units", "Odin");
    libBA5CCDED_gv_supplyMaxxed = BankValueGetAsFlag(libBA5CCDED_gv_eventBank, "Persistent Units", "SupplyMaxxed");
    libBA5CCDED_gv_genericDifficulty = BankValueGetAsFlag(libBA5CCDED_gv_eventBank, "Settings", "GenericDifficulty");
    libBA5CCDED_gv_nightmarePlus = BankValueGetAsFlag(libBA5CCDED_gv_eventBank, "Settings", "NightmarePlus");
    libBA5CCDED_gv_taurenAllowed = BankValueGetAsFlag(libBA5CCDED_gv_eventBank, "Persistent Units", "TaurenAllowed");
    libBA5CCDED_gv_stoneRescued = BankValueGetAsFlag(libBA5CCDED_gv_eventBank, "Persistent Units", "StoneRescued");
    TechTreeUpgradeAddLevel(1, (BankValueGetAsString(libBA5CCDED_gv_eventBank, "Persistent Units", "Warbot Upgrade")), 1);
    if ((libBA5CCDED_gv_genericDifficulty == true)) {
        TriggerExecute(libBA5CCDED_gt_ProtossGenericDifficulty, true, false);
        TriggerEnable(libBA5CCDED_gt_ZergTerranGenericDifficulty, true);
    }

    if ((libBA5CCDED_gv_nightmarePlus == true)) {
        TriggerEnable(libBA5CCDED_gt_NightmarePlusEvent, true);
    }

    if ((libBA5CCDED_gv_supplyMaxxed == true)) {
        PlayerModifyPropertyInt(1, c_playerPropSuppliesMade, c_playerPropOperSetTo, 200);
    }

    if ((libBA5CCDED_gv_taurenAllowed == true)) {
        PlayerModifyPropertyInt(1, c_playerPropSuppliesMade, c_playerPropOperSetTo, 200);
    }

    if ((libBA5CCDED_gv_stoneRescued == true)) {
        TechTreeUpgradeAddLevel(1, "SlagShellsBellyBonus", 1);
        TechTreeUpgradeAddLevel(1, "HeatTreatedNanitesBellyBonus", 1);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libBA5CCDED_gt_OpenBanks_Init () {
    libBA5CCDED_gt_OpenBanks = TriggerCreate("libBA5CCDED_gt_OpenBanks_Func");
    TriggerAddEventMapInit(libBA5CCDED_gt_OpenBanks);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Save Banks
//--------------------------------------------------------------------------------------------------
