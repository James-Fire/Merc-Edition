//--------------------------------------------------------------------------------------------------
// Trigger: ETC Death Metal Dance
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_ETCDeathMetalDance_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_counter;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_counter = RandomFixed(0.0, 300.0);

    // Actions
    if (!runActions) {
        return true;
    }

    while ((UnitHasBehavior2(EventUnit(), "L800DeathMetalDance") == true)) {
        Wait(0.0625, c_timeGame);
        UnitSetFacing(EventUnit(), lv_counter, 0.0);
        lv_counter += 10.0;
        if ((lv_counter >= 360.0)) {
            lv_counter = 0.0;
        }

    }
    return true;
}

