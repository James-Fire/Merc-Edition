//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_NightmarePlus_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((libBA5CCDED_gv_nightmarePlus == true)) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Enemies no longer deal +25% damage"));
        libBA5CCDED_gv_nightmarePlus = false;
        TriggerEnable(libBA5CCDED_gt_NightmarePlusEvent, false);
    }
    else {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Enemies deal +25% damage"));
        libBA5CCDED_gv_nightmarePlus = true;
        TriggerEnable(libBA5CCDED_gt_NightmarePlusEvent, true);
    }
    return true;
}

