    SoundPlayForPlayer(SoundLink("UIArmoryPurchaseButtonPress2", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    SoundPlayForPlayer(SoundLink("UIArmoryPurchaseButtonPress3", -1), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
