// Trigger: MU_UpgradeButtonPressed
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_MU_UpgradeButtonPressed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libBA5CCDED_gf_MU_UsedUpgradeButton(EventDialogControl()) == true))) {
            return false;
        }

        if (!((EventPlayer() == 1))) {
            return false;
        }

        if (!((libBA5CCDED_gv_mU_PurchaseInProgress == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libBA5CCDED_gt_UpgradeButtonSFX, true, false);
    libBA5CCDED_gf_MU_SetInfoPanel(libBA5CCDED_gf_MU_UsedUpgrade(EventDialogControl()));
    libBA5CCDED_gv_mU_Armory.lv_selected_Category = libBA5CCDED_gv_mU_Armory.lv_used_Category;
    libBA5CCDED_gv_mU_Armory.lv_selected_Unit = libBA5CCDED_gv_mU_Armory.lv_used_Unit;
    libBA5CCDED_gv_mU_Armory.lv_selected_Upgrade = libBA5CCDED_gv_mU_Armory.lv_used_Upgrade;
    libBA5CCDED_gv_mU_Armory.lv_selectedUpgrade = libBA5CCDED_gv_mU_Armory.lv_armyCategory_SlotUpgrade[libBA5CCDED_gv_mU_Armory.lv_used_Category][libBA5CCDED_gv_mU_Armory.lv_used_Unit][libBA5CCDED_gv_mU_Armory.lv_used_Upgrade];
    libCamp_gf_MercClearTechNew(libBA5CCDED_gf_MU_UpgradeTech(libBA5CCDED_gf_MU_UsedUpgrade(EventDialogControl())));
    return true;
}

