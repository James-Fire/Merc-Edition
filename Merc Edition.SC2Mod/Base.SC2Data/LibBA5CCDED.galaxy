//--------------------------------------------------------------------------------------------------
// Trigger: Hill Respawn
//--------------------------------------------------------------------------------------------------
bool libBA5CCDED_gt_HillRespawn_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_hill;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) == "SpectreNo15") || (UnitGetType(EventUnit()) == "Echo") || (UnitGetType(EventUnit()) == "GravenHill")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_hill = EventUnit();
    UnitSetPropertyFixed(lv_hill, c_unitPropLifePercent, 100.0);
    if ((TimerGetRemaining(libBA5CCDED_gv_hillRespawnTimer) <= 0.0)) {
        if ((UnitGetType(EventUnit()) == "Echo")) {
            UnitCreateEffectPoint(lv_hill, "NukeDetonate", UnitGetPosition(lv_hill));
        }

        libNtve_gf_MakeUnitInvulnerable(lv_hill, true);
        libNtve_gf_MakeUnitUncommandable(lv_hill, true);
        UnitSetPosition(lv_hill, libBA5CCDED_gv_hillRespawnPoint, false);
        UnitCreateEffectUnit(lv_hill, ("HillReviveDummy"), lv_hill);
        TimerStart(libBA5CCDED_gv_hillRespawnTimer, 120.0, false, c_timeGame);
        UnitBehaviorAdd(lv_hill, "Hill180sRespawn", lv_hill, 1);
        Wait(180.0, c_timeGame);
        libNtve_gf_MakeUnitInvulnerable(lv_hill, false);
        libNtve_gf_MakeUnitUncommandable(lv_hill, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libBA5CCDED_gt_HillRespawn_Init () {
    libBA5CCDED_gt_HillRespawn = TriggerCreate("libBA5CCDED_gt_HillRespawn_Func");
    TriggerEnable(libBA5CCDED_gt_HillRespawn, false);
    TriggerAddEventUnitDamaged(libBA5CCDED_gt_HillRespawn, null, c_unitDamageTypeAny, c_unitDamageFatal, null);
    TriggerAddEventUnitDamageAbsorbed(libBA5CCDED_gt_HillRespawn, null, "GenericDontDie");
}

