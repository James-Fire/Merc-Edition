<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- Brood War skins. Apply per player with "Apply Skin (Replacing Existing Units)"
         (libNtve_gf_PlayerApplySkinReplacingExistingUnit), like Taldarimify / Ihanriiify. -->
    <CSkin id="MarineBroodWar">
        <ReplacementArray Catalog="Model" From="Marine" To="MarineSCBW"/>
        <ReplacementArray Catalog="Model" From="MarineDeath" To="MarineSCBW@Death"/>
        <ReplacementArray Catalog="Model" From="MarineDeathAcid" To="MarineSCBW@DeathAcid"/>
        <ReplacementArray Catalog="Model" From="MarineDeathBlast" To="MarineSCBW@DeathBlast"/>
        <ReplacementArray Catalog="Model" From="MarineDeathFire" To="MarineSCBW@DeathFire"/>
        <ReplacementArray Catalog="Model" From="MarineDeathRagdoll" To="MarineSCBW@DeathRagdoll"/>
        <ReplacementArray Catalog="Model" From="MarineDeathEviscerate" To="MarineSCBW@DeathEviscerate"/>
        <ReplacementArray Catalog="Model" From="MarinePortrait" To="MarineSCBW@Portrait"/>
        <EffectArray Operation="Set" Reference="Actor,Marine,UnitIcon" Value="Assets\Textures\btn-unit-terran-marine@scbw.dds"/>
        <EffectArray Operation="Set" Reference="Actor,Marine,Wireframe.Image[0]" Value="Assets\Textures\wireframe-terran-marine@scbw.dds"/>
        <EffectArray Operation="Set" Reference="Actor,Marine,GroupIcon.Image[0]" Value="Assets\Textures\wireframe-terran-marine@scbw.dds"/>
        <EffectArray Operation="Set" Reference="Button,Marine,Icon" Value="Assets\Textures\btn-unit-terran-marine@scbw.dds"/>
        <EffectArray Operation="Set" Reference="Button,Marine,AlertIcon" Value="Assets\Textures\btn-unit-terran-marine@scbw.dds"/>
        <DisplayModel value="MarineSCBW"/>
    </CSkin>
    <CSkin id="BarracksBroodWar">
