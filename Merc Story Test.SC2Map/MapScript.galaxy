//--------------------------------------------------------------------------------------------------
// Trigger: Story Test - Button Clicked
//--------------------------------------------------------------------------------------------------
bool gt_StoryTestButtonClicked_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_tech;
    bool lv_bought;
    int lv_creditsBefore;
    int lv_merc;
    int lv_scene;

    // Automatic Variable Declarations
    const int auto6D2AE6FE_ae = 44;
    const int auto6D2AE6FE_ai = 1;
    int autoD4BB34AC_i;
    int autoDC0D4B03_i;
    int auto4388F340_i;
    int autoC2AC4153_i;

    // Variable Initialization
    lv_merc = libCamp_ge_StoryMercID_MercNone;
    lv_scene = libCamp_ge_SceneID_SceneNone;

    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[1])) {
        gf_StoryTestWinMission(DialogControlGetSelectedItem(gv_consoleMissionList, 1), 1);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[2])) {
        gf_StoryTestWinMission(DialogControlGetSelectedItem(gv_consoleMissionList, 1), 2);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[3])) {
        gf_StoryTestWinMission(DialogControlGetSelectedItem(gv_consoleMissionList, 1), 3);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[4])) {
        gf_StoryTestSaveCampaign();
        gf_StoryTestLog(StringToText("Launching the selected mission..."));
        libCamp_gf_LaunchMission(gv_missions[DialogControlGetSelectedItem(gv_consoleMissionList, 1)], false, PlayerDifficulty(1));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[5])) {
        libCamp_gf_SetStoryCredits((libCamp_gf_StoryCredits() + 1000));
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("+1,000 credits."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[6])) {
        libCamp_gf_SetStoryCredits((libCamp_gf_StoryCredits() + 10000));
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("+10,000 credits."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[7])) {
        libCamp_gf_SetStoryCredits(0);
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("Credits set to 0."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[8])) {
        libCamp_gf_MercDebugAddResearchLevel(0, 5);
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("+5 Protoss research level."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[9])) {
        libCamp_gf_MercDebugAddResearchLevel(5, 0);
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("+5 Zerg research level."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[10])) {
        lv_creditsBefore = libCamp_gf_StoryCredits();
        libCamp_gf_SetStoryCredits(9999999);
        lv_tech = 1;
        for ( ; ( (auto6D2AE6FE_ai >= 0 && lv_tech <= auto6D2AE6FE_ae) || (auto6D2AE6FE_ai < 0 && lv_tech >= auto6D2AE6FE_ae) ) ; lv_tech += auto6D2AE6FE_ai ) {
            lv_bought = libCamp_gf_MercTryPurchaseTech(lv_tech);
        }
        libCamp_gf_SetStoryCredits(lv_creditsBefore);
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("Bought all available armory tech."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[11])) {
        autoD4BB34AC_i = libCamp_gv_TSC_MERC_FIRST;
        while (autoD4BB34AC_i <= libCamp_gv_TSC_MERC_LAST) {
            lv_merc = libCamp_gv_tS_MercID[autoD4BB34AC_i];
            libCamp_gf_SetMercStatus(lv_merc, libCamp_ge_StoryMercStatus_Purchased);
            autoD4BB34AC_i = autoD4BB34AC_i + 1;
        }
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("All mercenaries hired."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[12])) {
        autoDC0D4B03_i = libCamp_gv_TSC_MERC_FIRST;
        while (autoDC0D4B03_i <= libCamp_gv_TSC_MERC_LAST) {
            lv_merc = libCamp_gv_tS_MercID[autoDC0D4B03_i];
            libCamp_gf_SetMercStatus(lv_merc, libCamp_ge_StoryMercStatus_Available);
            autoDC0D4B03_i = autoDC0D4B03_i + 1;
        }
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("Mercenaries set back to available."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[13])) {
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchP11UltraCapacitors);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchP21OrbitalDepots);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchP31AutomatedRefinery);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchP41Raven);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchP51TechReactor);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchZ11ShrikeTurret);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchZ21PlanetaryFortress);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchZ31Predator);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchZ41CellularReactors);
        libCamp_gf_SetStoryResearchPurchased(libCamp_ge_StoryResearchID_ResearchZ51HiveMindEmulator);
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("First research option bought in every tier."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[14])) {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), false);
        gv_consoleShown = false;
        libCamp_gf_DisplayTechConsole(gt_StoryTestPanelClosed);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[15])) {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), false);
        gv_consoleShown = false;
        libCamp_gf_DisplayMercenaryPanel(gt_StoryTestPanelClosed);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[16])) {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), false);
        gv_consoleShown = false;
        libCamp_gf_DisplayResearchPanel(gt_StoryTestPanelClosed);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[17])) {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), false);
        gv_consoleShown = false;
        libCamp_gf_DisplayBattleReport(null, gt_StoryTestPanelClosed);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[18])) {
        auto4388F340_i = libCamp_gv_TSC_SCENE_FIRST;
        while (auto4388F340_i <= libCamp_gv_TSC_SCENE_LAST) {
            lv_scene = libCamp_gv_tS_SceneIDs[auto4388F340_i];
            libCamp_gf_SetScenePlayed(lv_scene, false);
            auto4388F340_i = auto4388F340_i + 1;
        }
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("All scenes marked unplayed."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[19])) {
        autoC2AC4153_i = libCamp_gv_TSC_SCENE_FIRST;
        while (autoC2AC4153_i <= libCamp_gv_TSC_SCENE_LAST) {
            lv_scene = libCamp_gv_tS_SceneIDs[autoC2AC4153_i];
            libCamp_gf_SetScenePlayed(lv_scene, true);
            autoC2AC4153_i = autoC2AC4153_i + 1;
        }
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("All scenes marked played."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[20])) {
        gf_StoryTestSaveCampaign();
        gf_StoryTestRefresh();
        gf_StoryTestLog(StringToText("Saved."));
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[21])) {
        gf_StoryTestSaveCampaign();
        gf_StoryTestLog(StringToText("Reloading..."));
        GameSetNextMap(GameMapPath());
        GameOver(1, c_gameOverVictory, false, false);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[22])) {
        BankLoad("TCampaign", 1);
        BankRemove(BankLastCreated());
        BankLoad("CampaignPS", 1);
        BankRemove(BankLastCreated());
        gf_StoryTestLog(StringToText("Campaign save wiped. Reloading..."));
        GameSetNextMap(GameMapPath());
        GameOver(1, c_gameOverVictory, false, false);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[23])) {
        gf_StoryTestSaveCampaign();
        gf_StoryTestLog(StringToText("Going to the hub..."));
        GameOver(1, c_gameOverVictory, false, false);
        return true;
    }

    if ((EventDialogControl() == gv_consoleButtons[24])) {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), false);
        gv_consoleShown = false;
        return true;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StoryTestButtonClicked_Init () {
    gt_StoryTestButtonClicked = TriggerCreate("gt_StoryTestButtonClicked_Func");
    TriggerAddEventDialogControl(gt_StoryTestButtonClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_StoryTestPanelClosed_Init();
    gt_StoryTestInit_Init();
    gt_StoryTestToggleHotkey_Init();
    gt_StoryTestToggleChat_Init();
    gt_StoryTestButtonClicked_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitGlobals();
    InitTriggers();
}
