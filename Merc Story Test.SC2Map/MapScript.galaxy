//--------------------------------------------------------------------------------------------------
// Trigger: Story Test - Toggle (Hotkey)
//--------------------------------------------------------------------------------------------------
bool gt_StoryTestToggleHotkey_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_consoleShown == true)) {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), false);
        gv_consoleShown = false;
    }
    else {
        DialogSetVisible(gv_consoleDialog, PlayerGroupAll(), true);
        gv_consoleShown = true;
        gf_StoryTestRefresh();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StoryTestToggleHotkey_Init () {
    gt_StoryTestToggleHotkey = TriggerCreate("gt_StoryTestToggleHotkey_Func");
    TriggerAddEventKeyPressed(gt_StoryTestToggleHotkey, 1, c_keyD, true, c_keyModifierStateRequire, c_keyModifierStateRequire, c_keyModifierStateExclude);
}

