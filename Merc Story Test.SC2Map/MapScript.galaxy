}

void gf_StoryTestRefresh () {
    // Variable Declarations
    int lv_i;
    int lv_selected;
    text lv_mark;

    // Automatic Variable Declarations
    const int autoE5CC7A20_ae = 30;
    const int autoE5CC7A20_ai = 1;

    // Variable Initialization
    lv_selected = 1;

    // Implementation
    libNtve_gf_SetDialogItemText(gv_consoleStatusLabel, ((((((((((StringToText("Credits  ") + IntToText(libCamp_gf_StoryCredits())) + StringToText("      Done  ")) + IntToText(libCamp_gf_NumberOfMissions(libCamp_ge_MissionCountOptions_Completed))) + StringToText(" / 29")) + StringToText("      Last win  ")) + libCamp_gf_MissionName(libCamp_gf_LastSuccessfulMission())) + StringToText("      Research  P ")) + IntToText(libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryProtoss))) + StringToText("  Z ")) + IntToText(libCamp_gf_StoryResearchPoints(libCamp_ge_StoryResearchCategory_ResearchCategoryZerg))), PlayerGroupAll());
    lv_selected = DialogControlGetSelectedItem(gv_consoleMissionList, 1);
    DialogControlRemoveAllItems(gv_consoleMissionList, PlayerGroupAll());
    lv_i = 1;
    for ( ; ( (autoE5CC7A20_ai >= 0 && lv_i <= autoE5CC7A20_ae) || (autoE5CC7A20_ai < 0 && lv_i >= autoE5CC7A20_ae) ) ; lv_i += autoE5CC7A20_ai ) {
        lv_mark = StringToText("[  ]   ");
        if ((libCamp_gf_MissionStatusCheck(gv_missions[lv_i], libCamp_ge_MissionStatus_Available) == true)) {
            lv_mark = StringToText("[>]   ");
        }

        if ((libCamp_gf_MissionStatusCheck(gv_missions[lv_i], libCamp_ge_MissionStatus_Completed) == true)) {
            lv_mark = StringToText("[x]   ");
        }

        DialogControlAddItem(gv_consoleMissionList, PlayerGroupAll(), (lv_mark + libCamp_gf_MissionName(gv_missions[lv_i])));
    }
    if ((lv_selected < 1)) {
        lv_selected = 1;
    }

    DialogControlSelectItem(gv_consoleMissionList, PlayerGroupAll(), lv_selected);
}

void gf_StoryTestWinMission (int lp_index, int lp_mode) {
    // Variable Declarations
    int lv_i;
    int lv_credits;
    int lv_earlierMissions;
    bank lv_campaignBank;

    // Automatic Variable Declarations
    const int auto6B8DA2A0_ae = 30;
    const int auto6B8DA2A0_ai = 1;

    // Variable Initialization

    // Implementation
    if ((lp_index < 1)) {
        gf_StoryTestLog(StringToText("Pick a mission in the list first."));
        return ;
    }

    gf_StoryTestSaveCampaign();
    BankLoad("TCampaign", 1);
    lv_campaignBank = BankLastCreated();
    lv_credits = BankValueGetAsInt(lv_campaignBank, "StoryStage", "8");
    lv_i = 1;
    for ( ; ( (auto6B8DA2A0_ai >= 0 && lv_i <= auto6B8DA2A0_ae) || (auto6B8DA2A0_ai < 0 && lv_i >= auto6B8DA2A0_ae) ) ; lv_i += auto6B8DA2A0_ai ) {
        if ((lv_i != lp_index) && (StringSub(gv_missionPathAverage, (((lp_index - 1) * 30) + lv_i), (((lp_index - 1) * 30) + lv_i)) == "1") && (libCamp_gf_MissionStatusCheck(gv_missions[lv_i], libCamp_ge_MissionStatus_Completed) == false)) {
            BankValueSetFromInt(lv_campaignBank, "MissionCompletedAge", IntToString(lv_i), (31 - lv_i));
            BankKeyRemove(lv_campaignBank, "MissionAvailableAge", IntToString(lv_i));
            lv_credits = (lv_credits + libCamp_gf_MissionReward(gv_missions[lv_i]));
            lv_earlierMissions = (lv_earlierMissions + 1);
        }

    }
    BankValueSetFromInt(lv_campaignBank, "StoryStage", "8", lv_credits);
    BankSave(lv_campaignBank);
    BankLoad("MercStoryTest", 1);
    BankValueSetFromInt(BankLastCreated(), "Pending", "Mission", lp_index);
    BankValueSetFromInt(BankLastCreated(), "Pending", "Mode", lp_mode);
    BankSave(BankLastCreated());
    gf_StoryTestLog(((((StringToText("Winning ") + libCamp_gf_MissionName(gv_missions[lp_index])) + StringToText(" (+")) + IntToText(lv_earlierMissions)) + StringToText(" earlier missions). Reloading...")));
    GameSetNextMap(GameMapPath());
    GameOver(1, c_gameOverVictory, false, false);
}

void gf_StoryTestAddButton (text lp_text, text lp_tooltip, int lp_x, int lp_y, int lp_width) {
    // Automatic Variable Declarations
    // Implementation
    DialogControlCreate(gv_consoleDialog, c_triggerControlTypeButton);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), lp_width, 40);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTopLeft, lp_x, lp_y);
    libNtve_gf_SetDialogItemText(DialogControlLastCreated(), lp_text, PlayerGroupAll());
    libNtve_gf_SetDialogItemTooltip(DialogControlLastCreated(), lp_tooltip, PlayerGroupAll());
    gv_consoleButtonCount = (gv_consoleButtonCount + 1);
    gv_consoleButtons[gv_consoleButtonCount] = DialogControlLastCreated();
}

